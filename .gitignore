node_modules/

# Your saved LinkedIn connections - contains real people's names and email
# addresses. Never commit this.
referrals/data/

# Local SQLite data for posts, comments, and query - each service's own
# database file, not meant to be shared via git.
blog/posts/data/
blog/comments/data/
blog/query/data/

# User accounts (emails, hashed passwords) - definitely never commit this.
auth/data/

# Holds APP_JWT_SECRET for docker-compose - a real secret, unlike the
# hardcoded Google client ID elsewhere in this repo. Never commit this.
.env

# Personal Claude Code settings for this project (permissions, hooks) -
# .claude/agents/ is shared, this file isn't.
.claude/settings.local.json