# Where Ollama is listening. Default is the local install; inside Docker the
# host's Ollama is reachable at http://host.docker.internal:11434.
OLLAMA_URL=http://localhost:11434

# Any model you have pulled. qwen2.5-coder:7b is a good default for DSA hints
# (~4.7GB). Smaller/faster: llama3.2:3b. Stronger if you have the RAM:
# qwen2.5-coder:14b.
TUTOR_MODEL=qwen2.5-coder:7b
