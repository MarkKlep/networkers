# Read by docker-compose.yml only - npm run dev sets nothing from here and
# falls back per-service (see auth/.env.example and blog/client/.env.example
# instead). GOOGLE_CLIENT_ID and REACT_APP_GOOGLE_CLIENT_ID must be equal.
APP_JWT_SECRET=
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
REACT_APP_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Practice coach (tutor service). Inside Docker the host's Ollama is reachable
# at http://host.docker.internal:11434. Any pulled model works.
OLLAMA_URL=http://localhost:11434
TUTOR_MODEL=qwen2.5-coder:7b
